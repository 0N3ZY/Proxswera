{
  "schemaVersion": 1,
  "application": "scramjetfork",
  "policy": {
    "discovery": "environment-and-health",
    "unknownProvider": "disabled",
    "fallback": "fail-closed-for-stateful-and-authenticated-work",
    "productionChangesRequireApproval": true,
    "analytics": false,
    "paidPlanUpgrades": false
  },
  "providers": {
    "github": {
      "kind": "source-control",
      "capabilities": ["source-of-truth", "pull-requests", "ci", "release-gates", "provenance"],
      "trafficRole": "control-plane",
      "runtimeTraffic": false,
      "required": true
    },
    "vercel": {
      "kind": "frontend-platform",
      "capabilities": ["static-frontend", "cdn", "preview-deployments"],
      "trafficRole": "frontend",
      "runtimeTraffic": true,
      "required": false,
      "environment": {
        "origin": "VERCEL_FRONTEND_ORIGIN"
      }
    },
    "cloudflare": {
      "kind": "edge-platform",
      "capabilities": ["public-ingress", "request-routing", "firewall", "cache", "edge-health"],
      "trafficRole": "edge",
      "runtimeTraffic": true,
      "required": false,
      "environment": {
        "workerOrigin": "CLOUDFLARE_WORKER_ORIGIN",
        "renderOrigin": "RENDER_ORIGIN",
        "vercelOrigin": "VERCEL_FRONTEND_ORIGIN"
      }
    },
    "render": {
      "kind": "application-runtime",
      "capabilities": ["node-runtime", "wisp-websocket", "long-lived-http", "health-checks"],
      "trafficRole": "runtime",
      "runtimeTraffic": true,
      "required": true,
      "environment": {
        "origin": "RENDER_ORIGIN"
      }
    },
    "supabase": {
      "kind": "managed-data-platform",
      "capabilities": ["postgres", "auth", "storage", "realtime", "vectors"],
      "trafficRole": "data",
      "runtimeTraffic": false,
      "required": false,
      "environment": {
        "url": "SUPABASE_URL",
        "publishableKey": "SUPABASE_PUBLISHABLE_KEY",
        "serverSecret": "SUPABASE_SECRET_KEY"
      },
      "security": {
        "serverSecretServerSideOnly": true,
        "rlsRequiredForExposedTables": true,
        "neverUseUserMetadataForAuthorization": true
      }
    }
  },
  "routes": [
    {
      "match": "/wisp",
      "destination": "render",
      "protocols": ["websocket"],
      "cache": false,
      "reason": "Wisp sessions require the persistent Scramjet runtime."
    },
    {
      "match": "/api/*",
      "destination": "render",
      "protocols": ["http", "https"],
      "cache": false,
      "reason": "Application APIs and stateful runtime work stay on the application service."
    },
    {
      "match": "/healthz",
      "destination": "render",
      "protocols": ["http", "https"],
      "cache": false,
      "reason": "Runtime health must reflect the actual Render service."
    },
    {
      "match": "/__edge/health",
      "destination": "cloudflare",
      "protocols": ["http", "https"],
      "cache": false,
      "reason": "Edge health checks the configured upstreams without exposing credentials."
    },
    {
      "match": "/*",
      "destination": "vercel",
      "protocols": ["http", "https"],
      "cache": "static-assets-only",
      "reason": "The frontend is independently deployable and served from the frontend platform."
    }
  ]
}
